DATABASE_URL=sqlite:///./fixify.db
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI — GPT-4o Vision for AI image analysis
OPENAI_API_KEY=sk-your-openai-api-key-here

# AWS S3 — for photo storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=fixify-uploads
AWS_REGION=us-east-1

# Firebase — for push notifications (path to downloaded service account JSON)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# Google Maps — for truck route optimization
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# CORS — frontend URL
FRONTEND_URL=http://localhost:3000
