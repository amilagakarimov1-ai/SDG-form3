# Vercel Environment Variables
# Copy this to .env.local for local development
# For Vercel: add these in Project → Settings → Environment Variables

# Backend API URL (Railway/Render deployment URL)
VITE_API_URL=https://fixify-api.up.railway.app

# Mapbox token (optional — maps work without it via OpenStreetMap/Leaflet)
VITE_MAPBOX_TOKEN=
